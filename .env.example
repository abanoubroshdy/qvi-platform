NEXT_PUBLIC_SITE_URL=https://getqvi.com

# Supabase (authentication + waitlist storage)
# Project Settings -> API in the Supabase dashboard.
# The URL and the publishable/anon key are safe to expose to the browser.
# On Vercel, set these in Project Settings -> Environment Variables, then redeploy.
# Aliases also work: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Apply supabase/migrations/*.sql in the Supabase SQL editor
# (waitlist storage + user profiles: name, gender, country, DOB, phone).
# Only needed for privileged server-side operations (not required for
# email/password auth or the waitlist, which use the anon key + RLS).
# SUPABASE_SECRET_KEY=your-secret-key
