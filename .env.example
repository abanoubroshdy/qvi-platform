NEXT_PUBLIC_SITE_URL=https://getqvi.com

# Contact form (Resend) — messages go to support@getqvi.com by default
# Verify getqvi.com in Resend before using a custom from address.
CONTACT_TO_EMAIL=support@getqvi.com
CONTACT_FROM_EMAIL=QVI Contact <noreply@getqvi.com>
RESEND_API_KEY=re_your_resend_api_key

# Supabase (authentication + waitlist storage)
# Project Settings -> API in the Supabase dashboard.
# The URL and the publishable/anon key are safe to expose to the browser.
# On Vercel, set these in Project Settings -> Environment Variables, then redeploy.
# Aliases also work: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Apply supabase/migrations/*.sql in the Supabase SQL editor
# (waitlist storage, user profiles, and QV1 download history).
# Only needed for privileged server-side operations (not required for
# email/password auth or the waitlist, which use the anon key + RLS).
# SUPABASE_SECRET_KEY=your-secret-key

# Google AdSense — manual Display units on free /tools pages only.
# Set the same values in Vercel → Project Settings → Environment Variables
# (Production + Preview), then redeploy. Unset vars use these defaults.
# A blank value disables that field. Ads stay empty until the AdSense
# account leaves "Getting ready" and can fill. Do not turn on Auto ads.
# The live unit is fixed 300×250, so the page does not request a responsive format.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9019451998006609
NEXT_PUBLIC_ADSENSE_SLOT=5558098185
# Optional distinct slot for the bottom of a tool page. The same id as the
# top slot is ignored (one unit per slot per page). Leave unset until a
# second Display unit exists.
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# QV1 Evaluation installer (server only). A signed-in visit to /qv1/download
# records the download and redirects to a 1-hour presigned R2 GET.
# Leave these unset until the bucket credentials exist: the route then
# shows "Download coming soon". Do not prefix them with NEXT_PUBLIC_
# and do not commit real secrets. QV1_DOWNLOAD_URL is retired.
# Also run supabase/migrations/0005_qv1_downloads.sql in the Supabase SQL editor.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=qv1-downloads
# QV1_OBJECT_KEY=qv1/1.2.0/QV1-Setup-Evaluation.zip
