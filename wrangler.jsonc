{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getqvi-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Free plan. Do not set limits.cpu_ms above 10: that requires Workers Paid.
  // The account default on Free is 10 ms. Error 1102 means a request exceeded it.
  "workers_dev": true,
  // Version Preview URLs (<version>-getqvi-web.<subdomain>.workers.dev) after
  // `wrangler versions upload`. Not a custom domain and not getqvi.com.
  "preview_urls": true
}
